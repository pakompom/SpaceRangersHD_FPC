+    emscripten_webgl_init_context_attributes(&attributes);
+    attributes.alpha = _this->gl_config.alpha_size > 0;
+    attributes.depth = _this->gl_config.depth_size > 0;
+    attributes.stencil = _this->gl_config.stencil_size > 0;
+    attributes.antialias = _this->gl_config.multisamplebuffers > 0;
+    attributes.majorVersion = 1; /* SDL's GLES2 renderer */
