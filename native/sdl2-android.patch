+static void Android_PumpResizeEvents(_THIS)
+{
+    SDL_VideoData *videodata = (SDL_VideoData *)_this->driverdata;
+    if (videodata->isPaused || videodata->isPausing || SDL_HasEvent(SDL_QUIT)) {
+        return;
+    }
+    SDL_LockMutex(Android_ActivityMutex);
+    if (videodata->resizePending) {
+        videodata->resizePending = SDL_FALSE;
+        Android_SendResize(Android_Window);
+    }
+    SDL_UnlockMutex(Android_ActivityMutex);
+}
