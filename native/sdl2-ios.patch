+/* SpaceRangersHD: single-scene lifecycle support for iOS 15 and later. */
+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if ([scene isKindOfClass:[UIWindowScene class]] &&
+        [session.role isEqualToString:UIWindowSceneSessionRoleApplication]) {
+        [[SDLUIKitDelegate sharedAppDelegate] connectWindowScene:(UIWindowScene *)scene];
+    }
+}
+
+- (void)updateSceneGeometry:(UIWindowScene *)scene
+{
+    SDLUIKitDelegate *delegate = [SDLUIKitDelegate sharedAppDelegate];
+    if (delegate.windowScene != scene) {
+        return;
+    }
+    UIWindow *window = delegate.window;
+    if (window) {
+        window.frame = UIKit_GetSceneBounds(scene);
+        [window layoutIfNeeded];
+    }
+    SDL_OnApplicationDidChangeStatusBarOrientation();
+}
+
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        [self updateSceneGeometry:(UIWindowScene *)scene];
+    }
+}
+
+- (void)windowScene:(UIWindowScene *)scene didUpdateCoordinateSpace:(id<UICoordinateSpace>)previousCoordinateSpace interfaceOrientation:(UIInterfaceOrientation)previousInterfaceOrientation traitCollection:(UITraitCollection *)previousTraitCollection
+{
+    [self updateSceneGeometry:scene];
+}
+
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 260000
+- (void)windowScene:(UIWindowScene *)scene didUpdateEffectiveGeometry:(UIWindowSceneGeometry *)previousEffectiveGeometry API_AVAILABLE(ios(26.0))
+{
+    [self updateSceneGeometry:scene];
+}
+#endif
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    SDLUIKitDelegate *delegate = [SDLUIKitDelegate sharedAppDelegate];
+    if (delegate.windowScene == scene) {
+        delegate.window.hidden = YES;
+        delegate.window.windowScene = nil;
+        delegate.windowScene = nil;
+    }
+}
+
